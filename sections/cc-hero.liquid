{{ 'cc-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_image    = false
  if section.settings.background_image != blank
    assign has_image  = true
  endif

  assign text_align   = section.settings.text_alignment
  assign min_height   = section.settings.min_height
  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0

  assign badge_blocks = section.blocks | where: 'type', 'badge'
  assign button_blocks = section.blocks | where: 'type', 'button'
  assign trust_blocks  = section.blocks | where: 'type', 'trust_item'
-%}

{%- style -%}
  #cc-hero-{{ section.id }} {
    --cc-hero-bg-position: {{ section.settings.background_position }};
    --cc-hero-overlay-color: {{ section.settings.overlay_color | color_modify: 'alpha', overlay_alpha }};
  }
{%- endstyle -%}

<div
  id="cc-hero-{{ section.id }}"
  class="cc-hero cc-hero--{{ min_height }} cc-hero--{{ text_align }}{% unless has_image %} cc-hero--placeholder{% endunless %}"
>

  {%- comment -%} ── Background image ──────────────────── {%- endcomment -%}
  <div class="cc-hero__media" aria-hidden="true">
    {%- if has_image -%}
      {{
        section.settings.background_image
        | image_url: width: section.settings.background_image.width
        | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '375, 550, 750, 990, 1200, 1500, 1920',
            alt: ''
      }}
    {%- endif -%}
  </div>

  {%- comment -%} ── Eco overlay ───────────────────────── {%- endcomment -%}
  <div class="cc-hero__overlay" aria-hidden="true"></div>

  {%- comment -%} ── Content ───────────────────────────── {%- endcomment -%}
  <div class="cc-hero__content">

    {%- comment -%} Trust badge pills {%- endcomment -%}
    {%- if badge_blocks.size > 0 -%}
      <div class="cc-hero__badges">
        {%- for block in badge_blocks -%}
          <span class="cc-hero__badge" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <span class="cc-hero__badge-icon" aria-hidden="true">{{ block.settings.icon }}</span>
            {%- endif -%}
            {{ block.settings.text | escape }}
          </span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Headline — two-line typographic treatment {%- endcomment -%}
    {%- if section.settings.heading != blank or section.settings.heading_accent != blank -%}
      <h1 class="cc-hero__heading">
        {%- if section.settings.heading != blank -%}
          <span class="cc-hero__heading-line">{{ section.settings.heading | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading_accent != blank -%}
          <span class="cc-hero__heading-accent">{{ section.settings.heading_accent | escape }}</span>
        {%- endif -%}
      </h1>
    {%- endif -%}

    {%- comment -%} Subheading {%- endcomment -%}
    {%- if section.settings.subheading != blank -%}
      <p class="cc-hero__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- comment -%} CTA buttons {%- endcomment -%}
    {%- if button_blocks.size > 0 -%}
      <div class="cc-hero__ctas">
        {%- for block in button_blocks -%}
          {%- if block.settings.label != blank -%}
            <a
              href="{{ block.settings.link | default: '#' }}"
              class="cc-hero__btn cc-hero__btn--{{ block.settings.style }}"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.label | escape -}}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Trust signals {%- endcomment -%}
    {%- if trust_blocks.size > 0 -%}
      <ul class="cc-hero__trust">
        {%- for block in trust_blocks -%}
          <li class="cc-hero__trust-item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <span class="cc-hero__trust-icon" aria-hidden="true">{{ block.settings.icon }}</span>
            {%- endif -%}
            <span>{{ block.settings.text | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "CC Hero",
  "tag": "section",
  "class": "cc-hero-section spaced-section--full-width",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (line 1 — white)",
      "default": "Crystal Clear"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading (line 2 — accent green)",
      "default": "Eco Home Cleaning",
      "info": "Displays below line 1 in sage green. Leave blank to use a single-line heading."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Safe for People, Plants & Pets. Serving AZ, CA, OR, WA & TX."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left",   "label": "Left"   },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "min_height",
      "label": "Section height",
      "options": [
        { "value": "small",  "label": "Small (52rem)"      },
        { "value": "medium", "label": "Medium (68rem)"     },
        { "value": "large",  "label": "Large (80rem)"      },
        { "value": "full",   "label": "Full screen (100vh)" }
      ],
      "default": "large"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Recommended: at least 1920×1080px. A dark eco nature photo works best."
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Image focal point",
      "options": [
        { "value": "top center",    "label": "Top"    },
        { "value": "center center", "label": "Center" },
        { "value": "bottom center", "label": "Bottom" }
      ],
      "default": "center center"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay colour",
      "default": "#0d2212",
      "info": "Dark eco green keeps text legible over any photo."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 42,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Borders"
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Top border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "border_bottom",
      "label": "Bottom border",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust Badge",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "🌿",
          "info": "Use an emoji. Leave blank to hide."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Badge text",
          "default": "Est. 2023 • Scottsdale, AZ"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Book Your Clean"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "primary",   "label": "Primary (filled green)"  },
            { "value": "secondary", "label": "Secondary (glass/ghost)" }
          ],
          "default": "primary"
        }
      ]
    },
    {
      "type": "trust_item",
      "name": "Trust Signal",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Background-Checked Pros"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CC Hero",
      "blocks": [
        { "type": "badge",      "settings": { "icon": "🌿", "text": "Est. 2023 • Scottsdale, AZ" } },
        { "type": "badge",      "settings": { "icon": "⭐", "text": "5 States Strong" } },
        { "type": "button",     "settings": { "label": "Book Your Clean", "style": "primary"    } },
        { "type": "button",     "settings": { "label": "Learn More",      "style": "secondary"  } },
        { "type": "trust_item", "settings": { "icon": "🌿", "text": "FlowCheer Non-Toxic Supplies" } },
        { "type": "trust_item", "settings": { "icon": "🌳", "text": "1 Clean = 1 Tree Planted"     } },
        { "type": "trust_item", "settings": { "icon": "✓",  "text": "Background-Checked Pros"      } }
      ]
    }
  ]
}
{% endschema %}
